# Скопируйте этот файл в secrets.yaml (рядом с smart-door.yaml) и заполните
# своими значениями. secrets.yaml НЕ должен попадать в git (см. .gitignore).

wifi_ssid: "ВАШ_WIFI_SSID"
wifi_password: "ВАШ_WIFI_ПАРОЛЬ"

# Данные замка Gimdow A1 Ultra - получаются через Tuya Cloud / Tuya IoT
# Platform (local_key, uuid, device_id), MAC - из приложения Gimdow/Tuya
# или сканированием BLE. ble_unlock_check - только для A1 Ultra, параметр
# с кодом "ble_unlock_check" из Tuya Cloud API.
gimdow_local_key: "ВАШ_LOCAL_KEY"
gimdow_mac: "AA:BB:CC:DD:EE:FF"
gimdow_uuid: "ВАШ_UUID"
gimdow_device_id: "ВАШ_DEVICE_ID"
gimdow_ble_unlock_check: "ВАШ_BLE_UNLOCK_CHECK"
